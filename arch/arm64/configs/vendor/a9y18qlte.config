# Samsung Galaxy A9 (2018), a9y18qlte (SM-A920F), on top of
# vendor/sdm660-perf_defconfig.

# Board
CONFIG_SEC_A9Y18QLTE_PROJECT=y
CONFIG_MACH_A9Y18QLTE_EUR=y

# Image.gz-dtb with the A9 DTB appended (Samsung bootloader, boot header v0)
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_IMG_GZ_DTB=y

# pstore/ramoops: the 4.4 OrangeFox recovery reads crash logs from
# the same ramoops region (0x84d00000)
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Charging is SM5705 (charger + fuel gauge), not the pm660 SMB2/FG
# CONFIG_QPNP_SMB2 is not set
# CONFIG_QPNP_FG_GEN3 is not set
# CONFIG_QPNP_QNOVO5 is not set
# CONFIG_SMB1351_USB_CHARGER is not set
# CONFIG_SMB138X_CHARGER is not set
# CONFIG_QCOM_TADC is not set
