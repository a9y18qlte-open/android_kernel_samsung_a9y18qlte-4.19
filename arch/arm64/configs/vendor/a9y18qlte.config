# Samsung Galaxy A9 (2018), a9y18qlte (SM-A920F), on top of
# vendor/sdm660-perf_defconfig.

# Board
CONFIG_SEC_A9Y18QLTE_PROJECT=y
CONFIG_MACH_A9Y18QLTE_EUR=y

# Release version string without the git hash (-g<sha>)
# CONFIG_LOCALVERSION_AUTO is not set

# Image.gz-dtb with the A9 DTB appended (Samsung bootloader, boot header v0)
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_IMG_GZ_DTB=y

# pstore/ramoops: the 4.4 OrangeFox recovery reads crash logs from
# the same ramoops region (0x84d00000)
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Charging is SM5705 (charger + fuel gauge), not the pm660 SMB2/FG
# CONFIG_QPNP_SMB2 is not set
# CONFIG_QPNP_FG_GEN3 is not set
# CONFIG_QPNP_QNOVO5 is not set
# CONFIG_SMB1351_USB_CHARGER is not set
# CONFIG_SMB138X_CHARGER is not set
# CONFIG_QCOM_TADC is not set

# Panics: restart through msm-poweroff's PMIC warm reset (keeps DRAM and the
# ramoops log) instead of a watchdog bite, and don't arm Qualcomm download
# mode. On 4.4 Samsung's sec_debug kept download mode off at debug level low.
# CONFIG_QCOM_FORCE_WDOG_BITE_ON_PANIC is not set
CONFIG_CMDLINE="cgroup_disable=pressure msm_poweroff.download_mode=0"

# Samsung's bootloader loads the kernel 0x6c000 off a 2 MiB boundary, and
# arm64 shifts the kernel VA by the same amount. That leaves init_stack only
# 16 KiB aligned, so VMAP_STACK's overflow check (which needs stacks aligned
# to 2 * THREAD_SIZE) fires on the first exception: "kernel stack overflow".
# CONFIG_VMAP_STACK is not set

# Samsung's 4.4-era vendor blobs (libQSEEComAPI for keymaster, gatekeeper,
# qseecomd, ...) use the legacy ION API (old ALLOC struct, ION_IOC_MAP/FREE).
CONFIG_ION_LEGACY=y

# The ROM's FBE is v1 "ice" (FSCRYPT_MODE_PRIVATE) written by the 4.4 PFK,
# which programs ICE with the per-file key derived from nonce + master key.
CONFIG_ENABLE_LEGACY_PFK=y
# Samsung TZ only knows the legacy ES SET/INVALIDATE_ICE_KEY calls
CONFIG_QTI_CRYPTO_TZ_LEGACY_ICE_KEY=y

# Samsung debug (as on 4.4): sec_log/last_kmsg, restart reasons, sec_param
CONFIG_SEC_BSP=y
CONFIG_SEC_DEBUG=y
CONFIG_SEC_DEBUG_PRINTK_NOCACHE=y
CONFIG_SEC_LOG_LAST_KMSG=y
CONFIG_USER_RESET_DEBUG=y
CONFIG_SEC_DEBUG_SCHED_LOG=y
CONFIG_SEC_DEBUG_SUMMARY=y
CONFIG_QCOM_RTB=y
CONFIG_QCOM_RTB_SEPARATE_CPUS=y
CONFIG_SEC_DEBUG_POWER_LOG=y
CONFIG_SEC_DEBUG_PWDT=y

# Samsung display (as on 4.4): S6E3FA7 AMOLED panels via mdss samsung
CONFIG_FB_MSM_MDSS_SAMSUNG=y
CONFIG_DISPLAY_USE_INFO=y
CONFIG_PANEL_S6E3FA7_AMS604NL01_FHD=y
CONFIG_PANEL_S6E3FA7_AMS628RF01_FHD=y
CONFIG_LCD_CLASS_DEVICE=y

# Samsung touch (as on 4.4): Zinitix ZT7548, AVDD from the S2DOS03 on i2c-gpio
CONFIG_I2C_GPIO=y
CONFIG_REGULATOR_S2DOS03=y
CONFIG_SEC_DEBUG_TSP_LOG=y
CONFIG_INPUT_TOUCHSCREEN_TCLMV2=y
CONFIG_TOUCHSCREEN_DUMP_MODE=y
CONFIG_TOUCHSCREEN_ZINITIX_ZT75XX_TCLM=y
# Built-in firmware, as on 4.4: zinitix fails probe without its image,
# and the A96T3X6 grip sensor checks its image at probe
CONFIG_EXTRA_FIRMWARE="tsp_zinitix/zt7548_a9y18.fw abov/a96t326_a9y18qlte.fw"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"

# Samsung USB-C/charging chain (as on 4.4): S2MM005 CCIC, SM5705 MUIC/charger/FG, sec_battery
CONFIG_VBUS_NOTIFIER=y
CONFIG_VBUS_NOTIFIER_WORK=y
CONFIG_USE_MUIC=y
CONFIG_MUIC_NOTIFIER=y
CONFIG_MUIC_SUPPORT_CCIC=y
CONFIG_HICCUP_CHARGER=y
CONFIG_MUIC_UNIVERSAL=y
CONFIG_MUIC_UNIVERSAL_SM5705=y
CONFIG_MUIC_UNIVERSAL_SM5705_AFC=y
CONFIG_MUIC_SM5705_SWITCH_CONTROL_GPIO=y
CONFIG_MUIC_PINCTRL=y
CONFIG_MUIC_HV=y
CONFIG_CCIC_NOTIFIER=y
CONFIG_CCIC_S2MM005=y
CONFIG_CCIC_ALTERNATE_MODE=y
CONFIG_CCIC_LPM_ENABLE=y
CONFIG_MFD_SM5705=y
CONFIG_USB_HOST_NOTIFY=y
CONFIG_USB_NOTIFY_LAYER=y
CONFIG_USB_NOTIFIER=y
CONFIG_USB_NOTIFY_PROC_LOG=y
CONFIG_USB_EXTERNAL_NOTIFY=y
CONFIG_USB_TYPEC_MANAGER_NOTIFIER=y
CONFIG_BATTERY_SAMSUNG=y
CONFIG_BATTERY_SAMSUNG_V2=y
CONFIG_BATTERY_SAMSUNG_DATA_FILE="default_battery_data.h"
CONFIG_BATTERY_SWELLING=y
CONFIG_BATTERY_CISD=y
CONFIG_FUELGAUGE_SM5705=y
CONFIG_CHARGER_SM5705=y
CONFIG_AFC_CHARGER_MODE=y
CONFIG_BATTERY_AGE_FORECAST=y
CONFIG_BATTERY_NOTIFIER=y
CONFIG_SAMSUNG_LPM_MODE=y
CONFIG_GPIO_KTS1620=y

# Samsung vibrator (as on 4.4): DC motor on S2DOS03 LDO4 via timed_output
CONFIG_ANDROID_TIMED_OUTPUT=y
CONFIG_MSM_VIBRATOR=y
CONFIG_SENSORS_HALL=y
CONFIG_NFC_PN547=y
CONFIG_SEC_NFC_LOGGER=y
CONFIG_SEC_THERMISTOR=y

# Samsung grip sensor (as on 4.4)
CONFIG_SENSORS=y
CONFIG_SENSORS_A96T3X6=y

# Samsung fingerprint (as on 4.4): ET5XX on TZ-owned spi_3
CONFIG_SENSORS_FINGERPRINT=y
CONFIG_SENSORS_ET5XX=y
CONFIG_SENSORS_FP_SPI_NUMBER=3

# Samsung audio (as on 4.4): NXP TFA9872 speaker amplifier
CONFIG_SND_SOC_TFA9872=y

# Samsung audio (as on 4.4): ADSP adaptation (TFA DSP transport)
CONFIG_SEC_SND_ADAPTATION=y

# Samsung audio (as on 4.4): 3.5 mm jack (sec_jack, h2w switch)
CONFIG_SWITCH=y
CONFIG_SAMSUNG_JACK=y

# Samsung camera (as on 4.4): camera_v2 Samsung options
CONFIG_MSM_FRONT_EEPROM=y
CONFIG_CAMERA_SYSFS_V2=y
CONFIG_SAMSUNG_MULTI_CAMERA=y
CONFIG_GET_REAR_MODULE_ID=y
CONFIG_GET_FRONT_MODULE_ID=y
CONFIG_CAMERA_DUAL_REAR=y
CONFIG_CAMERA_QUAD_REAR=y
CONFIG_A9Y18_ACTUATOR=y

# Samsung flash LED (as on 4.4): SM5705, the camera_v2 EXT_PMIC flash
CONFIG_LEDS_SM5705=y
CONFIG_LEDS_SEPARATE_PREFLASH=y

# WLAN (as on 4.4): built-in qcacld-3.0 with the Samsung features, loaded by
# macloader through /sys/kernel/boot_wlan
CONFIG_QCA_CLD_WLAN=y

# exFAT for SD cards. 4.4 used Samsung sdFAT (SDFAT_USE_FOR_EXFAT); 4.19 has the
# upstream exfat driver, which vold mounts as "exfat"
CONFIG_EXFAT_FS=y

# Samsung SD slot (as on 4.4): SIM/SD tray card detect
CONFIG_SEC_HYBRID_TRAY=y

# USB as on 4.4: the ROM's Samsung USB modes use acm.0, and the USB
# ethernet drivers 4.4 had on top of the LineageOS set
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_NET_CDC_EEM=y
CONFIG_USB_NET_CDC_MBIM=y
CONFIG_USB_NET_SMSC75XX=y
CONFIG_USB_NET_SMSC95XX=y

# Mobile data as on 4.4: Samsung's RIL (libsec-ril, rtm_rmnet_enabled=0)
# creates the rmnet_data links over the legacy rmnet_data netlink, not the
# upstream rtnetlink rmnet
CONFIG_RMNET_DATA=y
CONFIG_RMNET_DATA_FC=y
# CONFIG_RMNET is not set

# Allow section mismatches without failing modpost build
CONFIG_SECTION_MISMATCH_WARN_ONLY=y
