# Samsung Galaxy A9 (2018), a9y18qlte (SM-A920F), on top of
# vendor/sdm660-perf_defconfig.

# Board
CONFIG_SEC_A9Y18QLTE_PROJECT=y
CONFIG_MACH_A9Y18QLTE_EUR=y

# Image.gz-dtb with the A9 DTB appended (Samsung bootloader, boot header v0)
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_IMG_GZ_DTB=y

# pstore/ramoops: the 4.4 OrangeFox recovery reads crash logs from
# the same ramoops region (0x84d00000)
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Charging is SM5705 (charger + fuel gauge), not the pm660 SMB2/FG
# CONFIG_QPNP_SMB2 is not set
# CONFIG_QPNP_FG_GEN3 is not set
# CONFIG_QPNP_QNOVO5 is not set
# CONFIG_SMB1351_USB_CHARGER is not set
# CONFIG_SMB138X_CHARGER is not set
# CONFIG_QCOM_TADC is not set

# Panics: restart through msm-poweroff's PMIC warm reset (keeps DRAM and the
# ramoops log) instead of a watchdog bite, and don't arm Qualcomm download
# mode. On 4.4 Samsung's sec_debug kept download mode off at debug level low.
# CONFIG_QCOM_FORCE_WDOG_BITE_ON_PANIC is not set
CONFIG_CMDLINE="cgroup_disable=pressure msm_poweroff.download_mode=0"

# Bring-up: early console into the ramoops console zone (ramoops_early=)
CONFIG_PSTORE_RAM_EARLY=y

# Samsung's bootloader loads the kernel 0x6c000 off a 2 MiB boundary, and
# arm64 shifts the kernel VA by the same amount. That leaves init_stack only
# 16 KiB aligned, so VMAP_STACK's overflow check (which needs stacks aligned
# to 2 * THREAD_SIZE) fires on the first exception: "kernel stack overflow".
# CONFIG_VMAP_STACK is not set

# Mark the boot as normal for Samsung's XBL (sec_debug stand-in)
CONFIG_SEC_BOOT_COOKIES=y

# Bring-up: turn silent hangs into panics with a backtrace
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=20
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y

# Samsung's 4.4-era vendor blobs (libQSEEComAPI for keymaster, gatekeeper,
# qseecomd, ...) use the legacy ION API (old ALLOC struct, ION_IOC_MAP/FREE).
CONFIG_ION_LEGACY=y

# The ROM's FBE is v1 "ice" (FSCRYPT_MODE_PRIVATE) written by the 4.4 PFK,
# which programs ICE with the per-file key derived from nonce + master key.
CONFIG_ENABLE_LEGACY_PFK=y
# Samsung TZ only knows the legacy ES SET/INVALIDATE_ICE_KEY calls
CONFIG_QTI_CRYPTO_TZ_LEGACY_ICE_KEY=y

# Samsung debug (as on 4.4): sec_log/last_kmsg, restart reasons, sec_param
CONFIG_SEC_BSP=y
CONFIG_SEC_DEBUG=y
CONFIG_SEC_DEBUG_PRINTK_NOCACHE=y
CONFIG_SEC_LOG_LAST_KMSG=y
CONFIG_USER_RESET_DEBUG=y
CONFIG_SEC_DEBUG_SCHED_LOG=y
CONFIG_SEC_DEBUG_SUMMARY=y
CONFIG_QCOM_RTB=y
CONFIG_QCOM_RTB_SEPARATE_CPUS=y
CONFIG_SEC_DEBUG_POWER_LOG=y
CONFIG_SEC_DEBUG_PWDT=y
